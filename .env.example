APP_NAME=Entradas
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Argentina/Buenos_Aires
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=entradas
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

# ---------------------------------------------------------------------------
# Reverb (servidor websocket)
# ---------------------------------------------------------------------------
# Un despliegue nuevo queda SIN websockets si no se completa esto. El servidor
# escucha en REVERB_SERVER_HOST:REVERB_SERVER_PORT y el navegador se conecta a
# ws://<host-del-sitio>:<puerto>.
#
# Advertencia: sin proxy inverso que resuelva el Upgrade de WebSocket, esto
# solo funciona en HTTP. Bajo HTTPS el handshake falla.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ---------------------------------------------------------------------------
# MercadoPago
# ---------------------------------------------------------------------------
# Credenciales OAuth de la aplicacion registrada en el panel de MP
# (https://www.mercadopago.com.ar/developers/panel/applications). Son las que
# usa el boton "Conectar por OAuth" del panel. Si las dejas vacias, igual se
# puede pegar el access_token a mano en Configuracion > MercadoPago.
#
# MP_CLIENT_ID        -> Application ID de tu app
# MP_CLIENT_SECRET    -> Application Secret
# MP_REDIRECT_URI     -> opcional. Por default se usa APP_URL + /tickets-admin/
#                        config/mp-callback. Seteala solo si tu APP_URL no es la
#                        que registraste en la app de MercadoPago.
# MP_REQUIRE_PUBLIC_URL -> true exige HTTPS publico para las callbacks de MP
#                        (obligatorio en produccion). En desarrollo local con
#                        tunel (ngrok, cloudflared) podes ponerlo en false para
#                        probar el checkout sin cerrar un pago real.
# ---------------------------------------------------------------------------
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI=
MP_REQUIRE_PUBLIC_URL=true